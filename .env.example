# Postgres. The app uses the pooled URL. Prisma migrate uses the direct URL.
DATABASE_URL=
DIRECT_URL=

# Clerk. The publishable key is public. The secret stays on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Arcjet. Leave ARCJET_ENV unset in production. Set it to development for local Playwright.
ARCJET_KEY=
# ARCJET_ENV=development

# Google Gemini. Receipt scanning and the monthly insight email.
GEMINI_API_KEY=
# Optional model chain (defaults: gemini-3.5-flash-lite, then gemini-3.6-flash).
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash

# Resend. Monthly report email.
RESEND_API_KEY=

# Inngest. Recurring transactions and the monthly email job. The SDK reads these.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# One-click demo. Must be a demo address. Defaults to maya@example.com.
DEMO_USER_EMAIL=maya@example.com

# Shared password for the six demo Clerk users. Used by seed:demo and Playwright, not by /demo.
DEMO_USER_PASSWORD=

# Playwright only. BASE_URL defaults to http://localhost:3000. RUN_PERF=1 runs the perf project.
# BASE_URL=
# RUN_PERF=

# Set to true to open the bundle analyzer while building.
# ANALYZE=

# SEO (all optional and public). The site URL defaults to the Vercel production host, then localhost.
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
